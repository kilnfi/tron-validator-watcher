# HELP tron_validator_watcher_account_activated Whether the validator account is activated on-chain (1) or not (0)
# TYPE tron_validator_watcher_account_activated gauge
tron_validator_watcher_account_activated{validator_address="val1.address",validator_name="val1"} 0
tron_validator_watcher_account_activated{validator_address="val2.address",validator_name="val2"} 0
# HELP tron_validator_watcher_active_srs The number of active Super Representatives on the network
# TYPE tron_validator_watcher_active_srs gauge
tron_validator_watcher_active_srs 0
# HELP tron_validator_watcher_balance The validator account balance, in TRX
# TYPE tron_validator_watcher_balance gauge
tron_validator_watcher_balance{validator_address="val1.address",validator_name="val1"} 0
tron_validator_watcher_balance{validator_address="val2.address",validator_name="val2"} 0
# HELP tron_validator_watcher_block_producer_info Block producer info
# TYPE tron_validator_watcher_block_producer_info gauge
tron_validator_watcher_block_producer_info{rank="10",validator_address="val1.address",validator_name="val1"} 0
tron_validator_watcher_block_producer_info{rank="20",validator_address="val2.address",validator_name="val2"} 0
# HELP tron_validator_watcher_brokerage The validator's brokerage (commission) rate, in percent
# TYPE tron_validator_watcher_brokerage gauge
tron_validator_watcher_brokerage{validator_address="val1.address",validator_name="val1"} 0
tron_validator_watcher_brokerage{validator_address="val2.address",validator_name="val2"} 0
# HELP tron_validator_watcher_consecutive_missed_blocks Current number of consecutive blocks missed by the validator (resets to 0 when a block is proposed)
# TYPE tron_validator_watcher_consecutive_missed_blocks gauge
tron_validator_watcher_consecutive_missed_blocks{epoch="100",validator_address="val1.address",validator_name="val1"} 0
tron_validator_watcher_consecutive_missed_blocks{epoch="100",validator_address="val2.address",validator_name="val2"} 0
# HELP tron_validator_watcher_epoch The current epoch
# TYPE tron_validator_watcher_epoch gauge
tron_validator_watcher_epoch 100
# HELP tron_validator_watcher_frozen_balance The validator's staked (frozen v2) TRX
# TYPE tron_validator_watcher_frozen_balance gauge
tron_validator_watcher_frozen_balance{validator_address="val1.address",validator_name="val1"} 0
tron_validator_watcher_frozen_balance{validator_address="val2.address",validator_name="val2"} 0
# HELP tron_validator_watcher_latest_block_processed_by_block_watcher The latest block processed by the block watcher
# TYPE tron_validator_watcher_latest_block_processed_by_block_watcher gauge
tron_validator_watcher_latest_block_processed_by_block_watcher 0
# HELP tron_validator_watcher_missed_blocks_total Total number of blocks missed by the validator
# TYPE tron_validator_watcher_missed_blocks_total counter
tron_validator_watcher_missed_blocks_total{epoch="100",validator_address="val1.address",validator_name="val1"} 0
tron_validator_watcher_missed_blocks_total{epoch="100",validator_address="val2.address",validator_name="val2"} 0
# HELP tron_validator_watcher_next_maintenance_time Unix timestamp (seconds) of the next maintenance period, when the SR set is reshuffled
# TYPE tron_validator_watcher_next_maintenance_time gauge
tron_validator_watcher_next_maintenance_time 0
# HELP tron_validator_watcher_node_head_block The latest block number reported by the TRON node (chain head)
# TYPE tron_validator_watcher_node_head_block gauge
tron_validator_watcher_node_head_block 0
# HELP tron_validator_watcher_node_up Whether the TRON node queried by the watcher is reachable (1) or not (0)
# TYPE tron_validator_watcher_node_up gauge
tron_validator_watcher_node_up 0
# HELP tron_validator_watcher_proposed_blocks_total Total number of blocks proposed by the validator
# TYPE tron_validator_watcher_proposed_blocks_total counter
tron_validator_watcher_proposed_blocks_total{epoch="100",validator_address="val1.address",validator_name="val1"} 0
tron_validator_watcher_proposed_blocks_total{epoch="100",validator_address="val2.address",validator_name="val2"} 0
# HELP tron_validator_watcher_rank The current ranking of the validator among all Super Representatives (1 = highest vote count). A validator is an active SR while its rank is within the active SR count.
# TYPE tron_validator_watcher_rank gauge
tron_validator_watcher_rank{validator_address="val1.address",validator_name="val1"} 10
tron_validator_watcher_rank{validator_address="val2.address",validator_name="val2"} 20
# HELP tron_validator_watcher_reward_balance The validator's claimable (unwithdrawn) rewards, in TRX
# TYPE tron_validator_watcher_reward_balance gauge
tron_validator_watcher_reward_balance{validator_address="val1.address",validator_name="val1"} 0
tron_validator_watcher_reward_balance{validator_address="val2.address",validator_name="val2"} 0
# HELP tron_validator_watcher_rewards_claimable Whether the validator has claimable rewards (1) or not (0)
# TYPE tron_validator_watcher_rewards_claimable gauge
tron_validator_watcher_rewards_claimable{validator_address="val1.address",validator_name="val1"} 0
tron_validator_watcher_rewards_claimable{validator_address="val2.address",validator_name="val2"} 0
# HELP tron_validator_watcher_round_progress The current progress of the round
# TYPE tron_validator_watcher_round_progress gauge
tron_validator_watcher_round_progress 0
# HELP tron_validator_watcher_votes The current number of votes received by the validator
# TYPE tron_validator_watcher_votes gauge
tron_validator_watcher_votes{validator_address="val1.address",validator_name="val1"} 0
tron_validator_watcher_votes{validator_address="val2.address",validator_name="val2"} 0
# HELP tron_validator_watcher_votes_margin_to_sr Votes separating the validator from the active SR cutoff: positive = cushion above the last SR seat, negative = votes needed to regain a seat
# TYPE tron_validator_watcher_votes_margin_to_sr gauge
tron_validator_watcher_votes_margin_to_sr{validator_address="val1.address",validator_name="val1"} 0
tron_validator_watcher_votes_margin_to_sr{validator_address="val2.address",validator_name="val2"} 0
# HELP tron_validator_watcher_votes_percentage The validator's share of the total network votes, in percent
# TYPE tron_validator_watcher_votes_percentage gauge
tron_validator_watcher_votes_percentage{validator_address="val1.address",validator_name="val1"} 0
tron_validator_watcher_votes_percentage{validator_address="val2.address",validator_name="val2"} 0
# HELP tron_validator_watcher_witness_total_missed_blocks Lifetime number of blocks missed by the validator, as reported by the node
# TYPE tron_validator_watcher_witness_total_missed_blocks gauge
tron_validator_watcher_witness_total_missed_blocks{validator_address="val1.address",validator_name="val1"} 0
tron_validator_watcher_witness_total_missed_blocks{validator_address="val2.address",validator_name="val2"} 0
# HELP tron_validator_watcher_witness_total_produced_blocks Lifetime number of blocks produced by the validator, as reported by the node
# TYPE tron_validator_watcher_witness_total_produced_blocks gauge
tron_validator_watcher_witness_total_produced_blocks{validator_address="val1.address",validator_name="val1"} 0
tron_validator_watcher_witness_total_produced_blocks{validator_address="val2.address",validator_name="val2"} 0
